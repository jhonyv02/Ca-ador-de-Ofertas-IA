# Crie um projeto NOVO no Supabase e rode a migration SQL.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_COLE_AQUI

# Apenas servidor. Nunca use prefixo NEXT_PUBLIC_ nesta chave.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# URL da implantação, para redirecionamento de confirmação de e-mail.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web Push. Gere com: npx web-push generate-vapid-keys
# A chave pública não é segredo, mas fica só no servidor e o site a entrega em /api/push/public-key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto:seu-email ou https://seu-dominio
VAPID_SUBJECT=mailto:seu-email@exemplo.com

# Mesmo valor gravado em private.push_settings no Supabase. Mínimo 24 caracteres.
PUSH_WEBHOOK_SECRET=

# Segredo da automação externa para /api/analyze/hook e /api/weekly-direct/hook.
# Mínimo 24 caracteres. Só no servidor. Não use o mesmo texto de exemplo do push.
ANALYZE_WEBHOOK_SECRET=

# Chave independente para a integração Grok -> Caçador (mín. 24 caracteres).
# O Grok precisa de ferramenta HTTP POST; esta chave fica SOMENTE em ambiente protegido.
GROK_WEBHOOK_SECRET=

# Chave secret/service_role do Supabase. Só no servidor, nunca com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Publicador Mundo Imprimível - somente no servidor, jamais NEXT_PUBLIC_
MI_PUBLISH_TOKEN=
MI_APPROVAL_TOKEN=
